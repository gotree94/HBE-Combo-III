# The default values for assignments are stored in the file
#		led_demo_assignment_defaults.qdf
# If this file doesn't exist, and for assignments not listed, see file
#		assignment_defaults.qdf

# Altera recommends that you do not modify this file. This
# file is updated automatically by the Quartus II software
# and any changes you make may be lost or overwritten.


set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C70F672C8
set_global_assignment -name TOP_LEVEL_ENTITY led_demo
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 6.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "09:08:55  MARCH 10, 2008"
set_global_assignment -name LAST_QUARTUS_VERSION 6.0
set_global_assignment -name VHDL_FILE led_clk_gen.vhd
set_global_assignment -name VHDL_FILE led_demo.vhd
set_global_assignment -name VHDL_FILE led_pwm_gen.vhd
set_location_assignment PIN_AF6 -to led_data[5]
set_location_assignment PIN_B2 -to led_data[15]
set_location_assignment PIN_AF9 -to led_data[2]
set_location_assignment PIN_AF23 -to led_data[12]
set_location_assignment PIN_AF7 -to led_data[4]
set_location_assignment PIN_AA24 -to led_data[9]
set_location_assignment PIN_AF13 -to led_data[14]
set_location_assignment PIN_AE10 -to led_data[1]
set_location_assignment PIN_AF5 -to led_data[6]
set_location_assignment PIN_G1 -to led_data[11]
set_location_assignment PIN_N2 -to clk
set_location_assignment PIN_AF8 -to led_data[3]
set_location_assignment PIN_AF10 -to led_data[8]
set_location_assignment PIN_AE24 -to led_data[13]
set_location_assignment PIN_AE11 -to led_data[0]
set_location_assignment PIN_G2 -to led_data[10]
set_location_assignment PIN_B3 -to led_data[7]
set_global_assignment -name AUTO_RESTART_CONFIGURATION OFF
set_global_assignment -name ENABLE_DEVICE_WIDE_RESET OFF
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"