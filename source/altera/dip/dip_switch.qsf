set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C70F672C8
set_global_assignment -name TOP_LEVEL_ENTITY dip_switch
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 6.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "10:14:40  MARCH 10, 2008"
set_global_assignment -name LAST_QUARTUS_VERSION 6.0
set_global_assignment -name VHDL_FILE dip_switch.vhd
set_global_assignment -name VHDL_FILE diptoseg.vhd
set_location_assignment PIN_U2 -to seg_com[2]
set_location_assignment PIN_P7 -to seg_data[1]
set_location_assignment PIN_V1 -to b_switch[6]
set_location_assignment PIN_T4 -to seg_data[0]
set_location_assignment PIN_T7 -to seg_com[0]
set_location_assignment PIN_N2 -to clk
set_location_assignment PIN_D3 -to ~nCSO~
set_location_assignment PIN_U6 -to b_switch[4]
set_location_assignment PIN_M5 -to seg_data[7]
set_location_assignment PIN_T3 -to seg_com[7]
set_location_assignment PIN_U4 -to b_switch[2]
set_location_assignment PIN_M4 -to seg_data[6]
set_location_assignment PIN_T2 -to seg_com[6]
set_location_assignment PIN_V5 -to b_switch[0]
set_location_assignment PIN_R5 -to seg_data[5]
set_location_assignment PIN_R7 -to seg_com[5]
set_location_assignment PIN_T6 -to b_switch[7]
set_location_assignment PIN_AE24 -to ~LVDS195p/nCEO~
set_location_assignment PIN_R4 -to seg_data[4]
set_location_assignment PIN_R6 -to seg_com[4]
set_location_assignment PIN_U7 -to b_switch[5]
set_location_assignment PIN_E3 -to ~ASDO~
set_location_assignment PIN_R3 -to seg_data[3]
set_location_assignment PIN_U3 -to seg_com[3]
set_location_assignment PIN_U5 -to b_switch[3]
set_location_assignment PIN_R2 -to seg_data[2]
set_location_assignment PIN_V6 -to b_switch[1]
set_location_assignment PIN_U1 -to seg_com[1]
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"