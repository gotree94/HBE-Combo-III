# The default values for assignments are stored in the file
#		rs232_demo_assignment_defaults.qdf
# If this file doesn't exist, and for assignments not listed, see file
#		assignment_defaults.qdf

# Altera recommends that you do not modify this file. This
# file is updated automatically by the Quartus II software
# and any changes you make may be lost or overwritten.


set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C70F672C8
set_global_assignment -name TOP_LEVEL_ENTITY rs232_demo
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 6.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:19:56  MARCH 10, 2008"
set_global_assignment -name LAST_QUARTUS_VERSION 6.0
set_global_assignment -name VHDL_FILE rs232_demo.vhd
set_global_assignment -name VHDL_FILE rs_232.vhd
set_location_assignment PIN_V1 -to parity_mode
set_location_assignment PIN_AE24 -to ~LVDS195p/nCEO~
set_location_assignment PIN_V4 -to reset
set_location_assignment PIN_T6 -to parity_en
set_location_assignment PIN_D3 -to ~nCSO~
set_location_assignment PIN_H3 -to rxd
set_location_assignment PIN_N2 -to clk
set_location_assignment PIN_E3 -to ~ASDO~
set_location_assignment PIN_F7 -to txd
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"